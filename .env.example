# Copy to .env.local and fill in. All values are read on the server only.
# Never prefix secrets with NEXT_PUBLIC_.

# PostgreSQL connection string (required).
# Local dev without Docker: `npm run db:dev` starts an embedded server on port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/roadtrip"

# Routing, geocoding and autocomplete (OpenRouteService, free key at https://openrouteservice.org/dev/#/signup).
# If unset, the app uses the demo provider and labels every result as DEMO DATA.
OPENROUTESERVICE_API_KEY=

# Points of interest: OpenStreetMap Overpass. Override to use another Overpass instance.
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# Descriptions and photos: Wikipedia and Wikimedia Commons (no key required).
# Wikimedia asks for an identifying User-Agent with a contact address.
WIKIMEDIA_USER_AGENT="RoadTripAI/0.1 (set-your-contact@example.com)"

# AI assistant (Anthropic). If unset, the assistant runs in DEMO mode with rule-based replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Map tiles (MapLibre style URL). Default is a keyless OpenStreetMap-based vector style.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Session lifetime in days.
SESSION_TTL_DAYS=30
