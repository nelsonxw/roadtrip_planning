# Copy to .env.local and fill in. All values are read on the server only.
# Never prefix secrets with NEXT_PUBLIC_.

# Firebase Firestore (required). Create a service account key in Firebase console > Project settings > Service accounts.
# Save the JSON file outside the project folder and point GOOGLE_APPLICATION_CREDENTIALS at it.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Hosted deployments (for example Vercel) have no key file: paste the whole service-account JSON here instead.
# When set, it is used in place of GOOGLE_APPLICATION_CREDENTIALS. Treat it as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Routing, geocoding and autocomplete (OpenRouteService, free key at https://openrouteservice.org/dev/#/signup).
# If unset, the app uses the demo provider and labels every result as DEMO DATA.
OPENROUTESERVICE_API_KEY=

# Places along the route: Geoapify (free plan, https://myprojects.geoapify.com). Requires attribution in the app (already shown).
# If GEOAPIFY_API_KEY is unset, the app uses OpenStreetMap Overpass below instead.
GEOAPIFY_API_KEY=

# Points of interest: OpenStreetMap Overpass (fallback when no Geoapify key). Override to use another Overpass instance.
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# Descriptions and photos: Wikipedia and Wikimedia Commons (no key required).
# Wikimedia asks for an identifying User-Agent with a contact address.
WIKIMEDIA_USER_AGENT="RoadTripAI/0.1 (set-your-contact@example.com)"

# AI assistant (Google Gemini, free tier). Create a key in Google AI Studio: https://aistudio.google.com/apikey
# Free-tier prompts and responses may be used by Google to improve its products. Do not put personal data in trip notes.
# If GEMINI_API_KEY is unset, the assistant runs in DEMO mode with rule-based replies.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"

# Anthropic (not yet wired up; reserved for a later adapter).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Map tiles (MapLibre style URL). Default is a keyless OpenStreetMap-based vector style.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Session lifetime in days.
SESSION_TTL_DAYS=30
